{
    "name": "endereco/endereco-oxid7-twig-client",
    "type": "oxideshop-module",
    "license": "GPL-3.0-only",
    "extra": {
        "oxideshop": {
            "target-directory": "endereco/endereco-oxid7-twig-client"
        },
        "hooks": {
            "pre-commit": [
                "composer qa"
            ]
        }
    },
    "authors": [
        {
            "name": "Ilja Weber",
            "email": "ilja@endereco.de"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.3.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "brainmaestro/composer-git-hooks": "^2.8",
        "phpstan/phpstan": "^2.0",
        "phpmd/phpmd": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "Endereco\\Oxid7Client\\": "src"
        }
    },
    "scripts": {
        "qa": [
            "@phpcs",
            "@phpmd",
            "@phpstan",
            "@phpcompat"
        ],
        "phpcbf": "phpcbf --standard=PSR12 ./src",
        "phpcs": "phpcs --standard=PSR12 ./src",
        "phpstan": [
            "phpstan analyse -c phpstan.7.1.neon --memory-limit=1G",
            "phpstan analyse -c phpstan.7.2.neon --memory-limit=1G",
            "phpstan analyse -c phpstan.7.3.neon --memory-limit=1G",
            "phpstan analyse -c phpstan.7.4.neon --memory-limit=1G",
            "phpstan analyse -c phpstan.7.5.neon --memory-limit=1G"
        ],
        "phpmd": "./check_phpmd.sh",
        "phpcompat": "bash test_php_versions.sh",
        "post-install-cmd": [
            "chmod +x test_php_versions.sh",
            "chmod +x check_phpmd.sh",
            "cghooks add --ignore-lock"
        ],
        "post-update-cmd": [
            "chmod +x test_php_versions.sh",
            "chmod +x check_phpmd.sh",
            "cghooks update"
        ]
    }
}
